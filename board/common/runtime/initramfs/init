#!/bin/busybox sh
# init: /init of the RAM initramfs. It carries two boot modes, and both act on a
# boot medium with nothing mounted from it:
#
#   flash mode (ota_url=... below)   stream an image and write it, then hand the
#                                    boot over to what was written
#   grow mode  (ram_mode=grow)       resize the root filesystem cold - see
#                                    bin/grow-rootfs for why that must not be
#                                    done from the running OS on this hardware
#
# Either way this runs from RAM only. No filesystem is mounted from the card while
# the card is written or resized, which is the point in both modes: the work cannot
# collide with a live rootfs, and no executable or script this runs is read back
# from the medium being changed.
#
# The OS side arms flash mode by baking parameters into the `flash` extlinux label
# and rebooting into it (ota-flash), and grow mode by pointing DEFAULT at the
# `grow` label (the growfs service, when the filesystem is smaller than its
# partition).
#
#   ota_url=http://host/alpine-<board>-<ver>.img.gz   image to stream
#   ota_sha256=<hex>       expected sha256 of the raw image
#   ota_size=<bytes>       expected raw image size
#   ota_bmap=http://host/…img.bmap                    block map for sparse writes
#   ota_target=/dev/mmcblk2                           whole disk to write
#   ota_rootpart=/dev/mmcblk2p1                       partition holding /boot
#   ota_mode=bmap|full                                sparse by default
#   ota_timeout=<seconds>                             read timeout for the image stream
#   ota_fill=0|1                                      extend the root partition to
#                                                    fill the card (default 1)
#
#   ram_mode=flash|grow                  which of the two modes this boot is; when
#                                        it is absent, ota_url decides, and a boot
#                                        with neither is grow mode
#   grow_label=<ext4 volume label>       which filesystem grow mode resizes
#                                        (default: rootfs)
#
# Sequence: parameters -> DHCP -> bmap -> write -> verify -> reboot.
# Before the first byte is written, any failure restores the saved extlinux.conf
# and reboots into the untouched OS. After that there is no way back: a failure
# leaves a partly written disk that must be re-flashed in a card reader.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

BUSYBOX=/bin/busybox
TMP=/tmp

# The console is not something anyone can read tomorrow, and flash mode has no
# network at all, so every line also goes to a log in RAM, stamped with the
# attempt's own clock (this machine has no RTC and never will in RAM: uptime is
# the only honest ordering). save_log() lands that log on the boot partition at
# each exit - see the end of this file.
LOG=$TMP/flash.log
log() { m="flash> t+$(awk '{ printf "%d", $1 }' /proc/uptime)s $*"; echo "$m"; echo "$m" >> "$LOG"; }
warn() { m="flash> t+$(awk '{ printf "%d", $1 }' /proc/uptime)s $*"; echo "$m" >&2; echo "$m" >> "$LOG"; }

# Every helper is a busybox applet from the initramfs; --install links them all.
[ -x "$BUSYBOX" ] || { echo "flash> no busybox in the initramfs" >&2; exec sh; }
$BUSYBOX --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p "$TMP"
mount -t tmpfs tmpfs "$TMP"

cmdline_value() { # $1 = key; matches the first token too, not just SP-separated
	tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | head -1
}

OTA_URL=$(cmdline_value ota_url)
OTA_SHA=$(cmdline_value ota_sha256)
OTA_SIZE=$(cmdline_value ota_size)
OTA_BMAP=$(cmdline_value ota_bmap)
OTA_TARGET=$(cmdline_value ota_target)
OTA_ROOTPART=$(cmdline_value ota_rootpart)
OTA_MODE=$(cmdline_value ota_mode)
OTA_HOSTNAME=$(cmdline_value ota_hostname)
OTA_TIMEOUT=$(cmdline_value ota_timeout)
RAM_MODE=$(cmdline_value ram_mode)
GROW_LABEL=$(cmdline_value grow_label)
# The stream can be quiet for a while on a slow or heavily emulated link without
# being dead, so it gets a much longer read timeout than the small metadata
# fetches. Short here means "abort and keep the installed system".
[ -n "${OTA_TIMEOUT:-}" ] || OTA_TIMEOUT=120

# ------------------------------------------------------------- recovery paths
restore_and_reboot() { # $1 = reason
	warn "$1"
	if [ -n "$OTA_ROOTPART" ] && [ -b "$OTA_ROOTPART" ]; then
		log "restoring the boot configuration and going back to the installed OS"
		if mkdir -p /mnt/root && mount -t ext4 "$OTA_ROOTPART" /mnt/root 2>/dev/null; then
			save_log /mnt/root
			if [ -f /mnt/root/boot/extlinux/extlinux.conf.bak ]; then
				cp /mnt/root/boot/extlinux/extlinux.conf.bak \
					/mnt/root/boot/extlinux/extlinux.conf &&
					log "extlinux.conf restored from extlinux.conf.bak"
			else
				warn "no extlinux.conf.bak on $OTA_ROOTPART: nothing restored"
			fi
			sync
			umount /mnt/root
		else
			warn "cannot mount $OTA_ROOTPART read-write: nothing restored"
		fi
	fi
	log "rebooting; the installed system is unchanged"
	sync
	reboot -f
	while true; do sleep 3600; done
}

# The partition-table helpers are shared with grow mode: both modes hand the rest
# of the disk to the root partition, and two copies of that byte dance would drift.
# mbr.sh is in the archive (bin/mbr.sh) and needs the applets linked above.
. /bin/mbr.sh

# ------------------------------------------------------------------- the record
# Flash mode runs in RAM with no network, so when something goes wrong the only
# thing that ever knew why was the HDMI console - and a machine that has come back
# up is the worst place to debug that from. Every exit writes the log to the boot
# partition instead, where the installed OS finds it as
# /var/log/flash-attempt.log.
# A write from this kernel leaves its own blocks in the buffer cache, and anything
# that mounts the target afterwards can read that pre-write view. A record written
# through it is at best a lie and at worst unwritable, so flush before trusting a
# mount that follows a flash.
flush_target_cache() {
	[ -n "${OTA_TARGET:-}" ] && [ -b "$OTA_TARGET" ] || return 0
	if command -v blockdev >/dev/null 2>&1; then
		blockdev --flushbufs "$OTA_TARGET" 2>/dev/null
	else
		sync
		echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
	fi
	return 0
}

save_log() { # $1 = an already-mounted boot partition, if there is one
	[ -n "${OTA_ROOTPART:-}" ] || return 0
	if [ ! -b "$OTA_ROOTPART" ]; then
		warn "cannot save the log: $OTA_ROOTPART is not a block device on this boot (the record stays on this console only)"
		return 0
	fi
	mp=$1
	if [ -z "$mp" ]; then
		mkdir -p /mnt/log
		# This partition may be the one this boot just wrote. Mounting it is the
		# point - the record has to land where the installed OS looks for it - but
		# a failure here used to be silent, and a successful flash that left no
		# log is exactly what that silence bought. Say what the error is, flush
		# the cache the write left behind, and try once more before giving up.
		if ! err=$(mount -t ext4 "$OTA_ROOTPART" /mnt/log 2>&1); then
			log "mount of $OTA_ROOTPART failed on the first attempt [$err]"
			flush_target_cache
			if ! err=$(mount -t ext4 "$OTA_ROOTPART" /mnt/log 2>&1); then
				warn "cannot mount $OTA_ROOTPART to save the log [$err]: the record stays on this console only"
				return 0
			fi
			log "mounted after flushing the target cache"
		fi
		mp=/mnt/log
	fi
	mkdir -p "$mp/var/log" 2>/dev/null
	{ echo "--- flash attempt: target $OTA_TARGET, mode ${OTA_MODE:-bmap}"; cat "$LOG" 2>/dev/null; } \
		>> "$mp/var/log/flash-attempt.log" 2>/dev/null
	sync
	[ "$mp" = /mnt/log ] && umount /mnt/log 2>/dev/null
	return 0
}

# Writing a disk that something has mounted is how a filesystem ends up with two
# writers: the kernel's cached copy can land on top of freshly written blocks.
# Nothing in flash mode should hold the target, so make a bug say so out loud.
assert_target_not_mounted() {
	if grep -qs "/dev/$(basename "$OTA_TARGET")" /proc/mounts; then
		restore_and_reboot "something on $OTA_TARGET is mounted: refusing to write underneath it"
	fi
	return 0
}

# ------------------------------------------- a target that is not the boot medium
# The usual flash targets the disk it was armed from, so the boot configuration is
# part of what gets replaced and there is nothing to restore afterwards. When the
# target is a *different* disk - flashing the eMMC from an SD, say - that
# configuration survives and is still armed: the machine would come back into flash
# mode after a successful flash, and after a reset in the middle of the slow part,
# with nothing left to clear it. So put the installed system back as the default
# before the slow part; the flash parameters stay in the label, and re-arming is a
# DEFAULT away.
disarm_boot_medium() { # $1 = force: disarm even when the target is the boot disk
	[ -n "${OTA_ROOTPART:-}" ] && [ -b "$OTA_ROOTPART" ] || return 0
	root_disk=$(mbr_whole_disk_of "$(basename "$OTA_ROOTPART")")
	if [ "${1:-}" != force ] && [ "$root_disk" = "$(basename "$OTA_TARGET")" ]; then
		return 0
	fi
	if [ "$root_disk" = "$(basename "$OTA_TARGET")" ]; then
		log "the target is the disk holding $OTA_ROOTPART: disarming before the write, since the image replaces this configuration anyway"
	else
		log "the target $(basename "$OTA_TARGET") is not the disk holding $OTA_ROOTPART ($root_disk)"
		log "putting the installed system back as the boot default for this boot"
	fi
	mkdir -p /mnt/root
	if ! mount -t ext4 "$OTA_ROOTPART" /mnt/root 2>/dev/null; then
		warn "cannot mount $OTA_ROOTPART to disarm: a reset would re-enter flash mode"
		return 0
	fi
	if [ -f /mnt/root/boot/extlinux/extlinux.conf.bak ]; then
		cp /mnt/root/boot/extlinux/extlinux.conf.bak /mnt/root/boot/extlinux/extlinux.conf &&
			log "DEFAULT is the installed system again"
	else
		warn "no extlinux.conf.bak on $OTA_ROOTPART: nothing to restore"
	fi
	sync
	umount /mnt/root
	return 0
}

give_up() { # $1 = reason; the disk has been touched, nothing can recover it here
	warn "$1"
	save_log
	echo
	echo "flash> ==================================================================="
	echo "flash> THE DISK HAS BEEN PARTLY WRITTEN."
	echo "flash> This machine cannot recover itself: the image being written was"
	echo "flash> the one it boots. Take the card out and flash it in a reader."
	echo "flash> ==================================================================="
	echo
	sync
	while true; do sleep 3600; done
}

# --------------------------------------------------------------- which mode
# Two modes share this initramfs. ram_mode is explicit and is what both labels
# carry; without it, ota_url decides, which is what an older image's flash label
# has; a RAM boot with neither is read as a grow request, so picking the `grow`
# label by hand at the menu does the obvious thing.
GROW_LABEL=${GROW_LABEL:-rootfs}
export GROW_LABEL
if [ "${RAM_MODE:-}" = grow ] || { [ -z "${RAM_MODE:-}" ] && [ -z "$OTA_URL" ]; }; then
	log "grow mode: resizing the filesystem labelled $GROW_LABEL with nothing mounted"
	exec /bin/grow-rootfs
elif [ "${RAM_MODE:-}" != flash ]; then
	log "ram_mode is '${RAM_MODE:-}' and ota_url is set: running flash mode"
fi

# ------------------------------------------------------------- sanity checks
[ -n "$OTA_URL" ] || restore_and_reboot "no ota_url on the kernel command line"
# A device node does not exist the moment devtmpfs is mounted: the mmc controllers
# are probed asynchronously and the eMMC - an 8-bit bus that runs tuning first -
# lands noticeably after the SD does. Waiting is what makes "the target is not a
# block device" mean that, instead of "not yet": checked three seconds after this
# init started, it refused before any network was attempted, restored the config
# and rebooted with nothing anywhere to say why. Log the inventory as it is found
# either way, so the next failure of this shape explains itself.
log "block devices at entry: $(ls /dev/mmcblk* /dev/vd* /dev/sd* 2>/dev/null | tr '\n' ' ')"
wait_for_device() { # $1 = device, $2 = seconds to wait
	t=0
	while [ "$t" -lt "${2:-20}" ]; do
		[ -b "$1" ] && break
		t=$((t + 1))
		sleep 1
	done
	if [ -b "$1" ]; then
		log "$1 appeared after ${t}s"
		return 0
	fi
	log "$1 did not appear in ${2:-20}s"
	return 1
}
# The root partition is only needed to restore the boot configuration on the way
# out, so it is not fatal for it to be late - or missing entirely.
wait_for_device "$OTA_ROOTPART" 20 || true
wait_for_device "$OTA_TARGET" 20 || true

[ -n "$OTA_TARGET" ] || restore_and_reboot "no ota_target on the kernel command line"
[ -b "$OTA_TARGET" ] || restore_and_reboot "$OTA_TARGET is not a block device"
[ -n "$OTA_SHA" ] || restore_and_reboot "no ota_sha256: refusing to write unverified"
[ -n "$OTA_SIZE" ] || restore_and_reboot "no ota_size: refusing to write"
case "$OTA_SIZE" in *[!0-9]*) restore_and_reboot "ota_size is not a number: $OTA_SIZE" ;; esac
[ -n "$OTA_MODE" ] || OTA_MODE=bmap

TARGET_BYTES=$(cat "/sys/class/block/$(basename "$OTA_TARGET")/size" 2>/dev/null)
case "$TARGET_BYTES" in
''|*[!0-9]*) restore_and_reboot "no sysfs size for $OTA_TARGET" ;;
esac
TARGET_BYTES=$((TARGET_BYTES * 512))
[ "$TARGET_BYTES" -ge "$OTA_SIZE" ] ||
	restore_and_reboot "$OTA_TARGET holds $TARGET_BYTES bytes, image needs $OTA_SIZE"

echo
echo "flash> Alpine flash mode"
echo "flash>   image    : $OTA_URL"
echo "flash>   sha256   : $OTA_SHA"
echo "flash>   size     : $OTA_SIZE bytes"
echo "flash>   mode     : $OTA_MODE"
echo "flash>   bmap     : ${OTA_BMAP:-none}"
echo "flash>   target   : $OTA_TARGET ($((TARGET_BYTES / 1048576)) MiB)"
echo "flash>   rootpart : ${OTA_ROOTPART:-unknown}"
echo "flash>   note     : this disk is the one that booted; the OS is not running"
echo

# --------------------------------------------------------------- networking
log "bringing up the wired interface"
if [ -n "$OTA_HOSTNAME" ]; then
	hostname "$OTA_HOSTNAME" 2>/dev/null
fi
ip link set eth0 up 2>/dev/null || restore_and_reboot "no eth0 in flash mode"

# A cold PHY takes a moment to train and every attempt made before the link is up
# is wasted. Wait for carrier, but not forever: a cable that is not there belongs in
# the installed system, not in a machine sitting in RAM.
carrier=0
while [ "$carrier" -lt 20 ]; do
	[ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = 1 ] && break
	carrier=$((carrier + 1))
	sleep 1
done
log "eth0 carrier after ${carrier}s: $(cat /sys/class/net/eth0/carrier 2>/dev/null || echo unknown), speed $(cat /sys/class/net/eth0/speed 2>/dev/null || echo unknown)"

# This network assigns by DHCP and only by DHCP: a static address is neither routed
# nor accepted here, which is true of anything with DHCP snooping or port security.
# So there is no handed-over address to try and no point accepting one on the
# command line - what a RAM init must do instead is leave a record of how far it
# got, because a failure at this point is otherwise invisible from anywhere.
got_ip=0
for attempt in 1 2 3 4; do
	log "dhcp attempt $attempt"
	if udhcpc -i eth0 -n -q -t 8 -T 3 -s /udhcpc.script >/dev/null 2>&1; then
		got_ip=1
		break
	fi
	sleep 3
done
[ "$got_ip" = 1 ] || restore_and_reboot "no DHCP lease on eth0"
IP=$(ip -4 -o addr show dev eth0 | awk '{ print $4 }' | head -1)
[ -n "$IP" ] || restore_and_reboot "eth0 has no IPv4 address after DHCP"
log "eth0 is up: $IP"
log "default route: $(ip route show default 2>/dev/null | head -1)"

wget_or() { # $1 = url, $2 = output file ("-" for stdout)
	wget -q -T 30 -O "$2" "$1" 2>/dev/null
}

log "checking the published metadata"
SIDE_SHA="${OTA_URL%.gz}.sha256"
SIDE_SIZE="${OTA_URL%.gz}.size"
wget_or "$SIDE_SHA" "$TMP/url.sha256" || restore_and_reboot "cannot fetch $SIDE_SHA"
wget_or "$SIDE_SIZE" "$TMP/url.size" || restore_and_reboot "cannot fetch $SIDE_SIZE"
PUB_SHA=$(awk '{ print $1; exit }' "$TMP/url.sha256")
PUB_SIZE=$(awk '{ print $1; exit }' "$TMP/url.size")
[ "$PUB_SHA" = "$OTA_SHA" ] ||
	restore_and_reboot "published sha256 ($PUB_SHA) is not what was armed ($OTA_SHA)"
[ "$PUB_SIZE" = "$OTA_SIZE" ] ||
	restore_and_reboot "published size ($PUB_SIZE) is not what was armed ($OTA_SIZE)"
log "metadata matches what was armed"

# ------------------------------------------------------------------- the bmap
if [ "$OTA_MODE" = bmap ]; then
	[ -n "$OTA_BMAP" ] || restore_and_reboot "ota_mode=bmap but no ota_bmap"
	log "fetching the block map"
	wget_or "$OTA_BMAP" "$TMP/image.bmap" || restore_and_reboot "cannot fetch $OTA_BMAP"
	BMAP_SIZE=$(awk '/<ImageSize>/ { gsub(/<[^>]*>/, " "); print $1; exit }' "$TMP/image.bmap")
	[ "$BMAP_SIZE" = "$OTA_SIZE" ] ||
		restore_and_reboot "bmap describes $BMAP_SIZE bytes, image is $OTA_SIZE"
	BMAP_RANGES=$(grep -c '<Range' "$TMP/image.bmap")
	[ "$BMAP_RANGES" -gt 0 ] || restore_and_reboot "bmap has no ranges"
	# The ranges are `<Range chksum="..."> start length </Range>`, so field 4 is the
	# byte count: summing them is what the write will actually move, and the progress
	# percentage has to be measured against that and not the whole image.
	BMAP_MAPPED=$(awk '/<Range/ { s += $4 } END { print s + 0 }' "$TMP/image.bmap")
	[ "$BMAP_MAPPED" -gt 0 ] || BMAP_MAPPED=$OTA_SIZE
	log "bmap ok: $BMAP_RANGES ranges, $((BMAP_MAPPED / 1048576)) MiB of the image is mapped"
fi

# The disk this boot configuration lives on is not always the disk being written -
# an eMMC flash armed from the SD, for instance. Put that configuration back on the
# installed system before anything slow: the target's own config is replaced by the
# image, but a config on a disk that is *not* written survives the flash and would
# send the machine straight back into flash mode.
disarm_boot_medium

echo
echo "flash> ==================================================================="
echo "flash> Writing $OTA_TARGET now. From this point on there is NO way back:"
echo "flash> a failure or a power cut needs a card reader and a fresh flash."
echo "flash> ==================================================================="
echo
sleep 10

# The boot configuration is put back *here*, before the write, and not only on the
# way out: a panic or a power cut skips every handler below, and a configuration
# still pointing at flash mode then sends the machine straight back into the same
# write, forever. Every refusal has already happened by this point, so writing the
# boot partition now cannot turn a refusal into a write - and it rewrites a block the
# image already fills, so the target still ends up byte for byte the image. The log
# deliberately stays out of this: a fresh log block would land in a gap no sparse
# write touches, and then the target *would* differ from the image.
disarm_boot_medium force

# A sparse write never touches the blocks between ranges and the image is zero
# there, so those blocks must already be zero on the target. Failing this check
# is a failure before the first byte: the installed system is still intact, and
# re-arming with --full writes every byte instead.
if [ "$OTA_MODE" = bmap ]; then
	log "checking that the target is zero where the image is"
	bmap-write --check-gaps -b "$TMP/image.bmap" -t "$OTA_TARGET" ||
		restore_and_reboot "the target is not zero where the image is: re-arm with --full to write every byte"
fi

assert_target_not_mounted

# ash has no PIPESTATUS: the status of `wget | gzip | bmap-write` is the writer's
# alone. So a download that died halfway reports as a write failure, and one that
# never started reports as a failure *after* the first byte - the one classification
# this machine cannot recover from. Each stage records its own status in a file and
# all three are read afterwards.
fetch() { # $1 = the writer's arguments
	rm -f "$TMP/wget.rc" "$TMP/gzip.rc"
	( wget -q -T "$OTA_TIMEOUT" -O - "$OTA_URL" 2>"$TMP/wget.err"; echo $? > "$TMP/wget.rc" ) |
		( gzip -dc 2>"$TMP/gzip.err"; echo $? > "$TMP/gzip.rc" ) |
		bmap-write $1 -t "$OTA_TARGET"
}

# Progress for the write itself, the same way the read-back below reports: watch the
# device's own write counter (field 7 of /sys/class/block/<dev>/stat, 512-byte
# sectors) rather than asking the writer, which has no idea how long the stream will
# be. A write that prints nothing for minutes is indistinguishable from a write that
# died, and the console is the only output this machine has.
write_total=$OTA_SIZE
[ "$OTA_MODE" = bmap ] && write_total=$BMAP_MAPPED
dev_stat="/sys/class/block/$(basename "$OTA_TARGET")/stat"
write_before=$(awk '{ print $7 }' "$dev_stat" 2>/dev/null)
(
	while :; do
		sleep 5
		[ -n "$write_before" ] || continue
		now=$(awk '{ print $7 }' "$dev_stat" 2>/dev/null)
		[ -n "$now" ] || continue
		written_bytes=$(( (now - write_before) * 512 ))
		[ "$written_bytes" -lt 0 ] && written_bytes=0
		pct=$((written_bytes * 100 / write_total))
		[ "$pct" -gt 99 ] && pct=99
		echo "[write]   $pct%  $((written_bytes / 1048576))/$((write_total / 1048576)) MiB written"
	done
) &
write_prog=$!

start=$(date +%s)
if [ "$OTA_MODE" = full ]; then
	log "streaming the whole image (mode=full, read timeout ${OTA_TIMEOUT}s)"
	fetch --full
	write_rc=$?
else
	log "streaming the image, writing mapped blocks only (mode=bmap, read timeout ${OTA_TIMEOUT}s)"
	fetch "-b $TMP/image.bmap"
	write_rc=$?
fi
kill "$write_prog" 2>/dev/null
wait "$write_prog" 2>/dev/null
# The plan is not the result. This used to print the planned total as "written"
# whatever happened, so a failed write announced 100% and then, two lines later,
# announced that it had failed - the one line in this log that could lie, lying
# exactly when a reader most needs it. Ask the target's own counter instead, and
# only claim completion when the writer actually exited zero.
if [ "$write_rc" = 0 ]; then
	echo "[write]   100%  $((write_total / 1048576))/$((write_total / 1048576)) MiB written"
else
	got=0
	now=$(awk '{ print $7 }' "$dev_stat" 2>/dev/null)
	if [ -n "$now" ] && [ -n "$write_before" ]; then
		got=$(( (now - write_before) * 512 ))
		[ "$got" -lt 0 ] && got=0
	fi
	echo "[write]   FAILED: $((got / 1048576))/$((write_total / 1048576)) MiB written before the stream ended"
fi
elapsed=$(( $(date +%s) - start ))
log "write finished in ${elapsed}s: writer $write_rc, wget $(cat "$TMP/wget.rc" 2>/dev/null || echo '?'), gzip $(cat "$TMP/gzip.rc" 2>/dev/null || echo '?')"
if [ "$write_rc" != 0 ]; then
	[ "$(cat "$TMP/wget.rc" 2>/dev/null || echo 1)" = 0 ] ||
		warn "the download failed: $(tail -1 "$TMP/wget.err" 2>/dev/null)"
	give_up "write failed"
fi

# ------------------------------------------------------------------ verification
magic=$(dd if="$OTA_TARGET" bs=1 skip=8192 count=8 2>/dev/null | od -A n -t x1 |
	sed 's/^ *//; s/  */ /g; s/ *$//')
log "u-boot magic at KiB 8: $magic"
case "$magic" in
"16 00 00 ea 65 47 4f 4e"*) : ;;
*) give_up "bootloader magic missing after the write" ;;
esac

if [ "$OTA_MODE" = full ]; then
	blocks=$(( (OTA_SIZE + 4194304 - 1) / 4194304 ))
	log "hashing $((OTA_SIZE / 1048576)) MiB read back from the target"
	# Progress for the read-back: this busybox has no dd status=progress, so
	# watch the device's own read counter (/sys/class/block/<dev>/stat, field 3,
	# in 512-byte sectors) instead of leaving the screen frozen for minutes.
	dev_stat="/sys/class/block/$(basename "$OTA_TARGET")/stat"
	verify_before=$(awk '{ print $3 }' "$dev_stat" 2>/dev/null)
	(
		while :; do
			sleep 5
			[ -n "$verify_before" ] || continue
			now=$(awk '{ print $3 }' "$dev_stat" 2>/dev/null)
			[ -n "$now" ] || continue
			read_bytes=$(( (now - verify_before) * 512 ))
			[ "$read_bytes" -lt 0 ] && read_bytes=0
			pct=$((read_bytes * 100 / OTA_SIZE))
			[ "$pct" -gt 99 ] && pct=99
			echo "[verify]  $pct%  $((read_bytes / 1048576))/$((OTA_SIZE / 1048576)) MiB read back"
		done
	) &
	verify_prog=$!
	got=$(dd if="$OTA_TARGET" bs=4M count="$blocks" 2>/dev/null | head -c "$OTA_SIZE" |
		sha256sum | awk '{ print $1 }')
	kill "$verify_prog" 2>/dev/null
	wait "$verify_prog" 2>/dev/null
	if [ "$got" = "$OTA_SHA" ]; then
		log "sha256 matches the published image"
	else
		give_up "sha256 mismatch: expected $OTA_SHA, got $got"
	fi
else
	log "range checksums were verified during the write (bmap)"
fi

# ------------------------------------------------- and the rest of the card
# The image's partition is image-sized, so a bigger card keeps its extra space
# unusable. Extend the partition here, before the reboot: the kernel reads the
# table fresh on the next boot, and the OS then arms one grow boot to grow the
# filesystem into it (the growfs service, then the grow label - the other mode of
# this same initramfs). Doing it from the running OS is not possible, the table
# cannot be re-read while the rootfs on it is mounted.
#
# A partition after the root one is never eaten: the extension stops at its start.
# That costs nothing today and is what keeps a recovery or persist partition
# possible later.
if [ "${OTA_FILL:-1}" = 1 ] && [ "$TARGET_BYTES" -gt "$OTA_SIZE" ]; then
	read -r ptyp pstart pcount <<EOF
$(mbr_entry "$OTA_TARGET" 0)
EOF
	if [ "${ptyp:-0}" = 131 ] && [ "${pstart:-0}" -ge 2048 ]; then
		disk_end=$(( TARGET_BYTES / 512 ))
		next_start=$(mbr_next_start "$OTA_TARGET" "${pstart:-0}")
		[ -n "$next_start" ] && end=$next_start || end=$disk_end
		new_count=$(( end - pstart ))
		if [ "$new_count" -gt "${pcount:-0}" ]; then
			mbr_write_count "$OTA_TARGET" 0 "$new_count"
			sync
			read -r _ _ got <<EOF
$(mbr_entry "$OTA_TARGET" 0)
EOF
			[ "${got:-0}" = "$new_count" ] ||
				give_up "cannot extend the root partition (wrote ${got:-nothing}, wanted $new_count)"
			log "root partition extended to $(($((pstart + new_count)) * 512 / 1048576)) MiB; the OS arms one grow boot to grow the filesystem"
		else
			log "the root partition already spans the card"
		fi
	else
		log "not touching the partition table (no primary 0x83 partition)"
	fi
fi

# The write replaced the partition table underneath this kernel. On a target that was blank
# the kernel never created a partition node at all, so $OTA_ROOTPART does not exist and the
# record cannot be written where the installed OS looks for it. Make the kernel re-read the
# table we just wrote (nothing is mounted from it, which is asserted above), then give
# devtmpfs a moment to publish the new node.
if [ -b "$OTA_TARGET" ]; then
	blockdev --rereadpt "$OTA_TARGET" 2>/dev/null
	if [ -n "${OTA_ROOTPART:-}" ]; then
		waited=0
		while [ ! -b "$OTA_ROOTPART" ] && [ "$waited" -lt 10 ]; do
			sleep 1
			waited=$((waited + 1))
		done
	fi
fi

sync
# The verify read the target back, but the blocks this kernel wrote can still be
# the cache's copy of it: flush before anything mounts the partition we just
# replaced, so the record goes through a view of the medium that is current.
flush_target_cache
echo
log "image written and verified"
log "rebooting into it; the new image boots the OS (its extlinux default is bsp)"
# Saved last: for the usual flash this partition is the one just written, and
# mounting it before the write would be a second writer on the target.
save_log
echo
reboot -f
while true; do sleep 3600; done
