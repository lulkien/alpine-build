#!/bin/sh
# ota-flash: arm the next boot into flash mode, then reboot into it.
#
# This script does NOT write the boot medium. Writing the medium that holds the
# running rootfs is what killed the earlier attempt: live ext4 writeback landed
# inside the image being written, and the flasher's own executables were read back
# from the very blocks dd was overwriting.
#
# Instead it prepares the `flash` extlinux label with the image URL and its
# metadata, saves the current boot configuration, sets DEFAULT flash and reboots.
# The next boot runs an initramfs (RAM only, no rootfs mounted) that downloads the
# image and writes it, so nothing on the disk is in use while it is written.
#
# Before the first byte is written, any failure inside flash mode restores
# extlinux.conf from extlinux.conf.bak and reboots into the untouched OS. After
# that point a failure leaves a partly written disk: only a card reader and a
# fresh flash can recover it.
#
# Usage:
#   ota-flash <url.img.gz> [-y] [--full] [--no-reboot] [--test]
#   ota-flash --status          show the armed parameters and the boot default
#   ota-flash --cancel          restore extlinux.conf and drop the arming
#
#   -y            skip the confirmation prompt
#   --full        write every byte of the image instead of the mapped blocks
#   --no-reboot   arm, but do not reboot
#   --test        fetch and check the metadata, change nothing
#
# Exit: 1 usage/root, 2 boot configuration problem, 3 source not reachable,
#       4 target problem, 6 preparation failed, 0 ok.

set -u

MB=1048576
EXTLINUX=/boot/extlinux/extlinux.conf
BAK=/boot/extlinux/extlinux.conf.bak
INITRAMFS=/boot/flash-initramfs.gz
LABEL=flash

die() { echo "[error] $*" >&2; exit "$2"; }

usage() {
	cat >&2 <<'EOF'
usage: ota-flash <url.img.gz> [-y] [--full] [--no-reboot] [--test]
       ota-flash --status | --cancel
EOF
	exit 1
}

[ "$(id -u)" = 0 ] || die "must run as root" 1

URL=""
ASSUME_YES=0
MODE=bmap
NO_REBOOT=0
TEST=0
ACTION=arm

while [ $# -gt 0 ]; do
	case "$1" in
	-y) ASSUME_YES=1; shift ;;
	--full) MODE=full; shift ;;
	--no-reboot) NO_REBOOT=1; shift ;;
	--test) TEST=1; shift ;;
	--status) ACTION=status; shift ;;
	--cancel) ACTION=cancel; shift ;;
	-h|--help) usage ;;
	-*) usage ;;
	*) [ -z "$URL" ] || usage; URL="$1"; shift ;;
	esac
done

# ------------------------------------------------------- boot configuration
[ -f "$EXTLINUX" ] || die "no $EXTLINUX: this image has no boot menu to arm" 2

whole_disk_of() { # $1 = partition or disk node name -> whole disk node name
	case "$1" in
	*nvme*|*mmcblk*) case "$1" in *p[0-9]*) printf '%s' "${1%p[0-9]*}" ;; *) printf '%s' "${1%[0-9]}" ;; esac ;;
	*) printf '%s' "$1" ;;
	esac
}

flash_append() { # print the APPEND line of the flash label
	awk -v want="$LABEL" '
		$1 == "LABEL" { inlabel = ($2 == want) }
		inlabel && $1 == "APPEND" { sub(/^[ \t]*APPEND[ \t]+/, ""); print; exit }
	' "$EXTLINUX"
}

boot_default() {
	awk '$1 == "DEFAULT" { print $2; exit }' "$EXTLINUX"
}

label_field() { # $1 = field name in the flash label (LINUX/FDT/INITRD)
	awk -v want="$LABEL" -v f="$1" '
		$1 == "LABEL" { inlabel = ($2 == want) }
		inlabel && $1 == f { print $2; exit }
	' "$EXTLINUX"
}

param_of() { # $1 = parameter name in the armed APPEND line
	flash_append | sed -n "s/.*$1=\([^ ]*\).*/\1/p"
}

if [ "$ACTION" = status ]; then
	echo "boot default : $(boot_default)"
	echo "armed url    : $(param_of ota_url)"
	echo "armed sha256 : $(param_of ota_sha256)"
	echo "armed mode   : $(param_of ota_mode)"
	echo "armed target : $(param_of ota_target)"
	if [ -f "$BAK" ]; then echo "backup       : $BAK present"; else echo "backup       : none"; fi
	echo "flash kernel : $(label_field LINUX)"
	echo "flash initrd : $(label_field INITRD)"
	exit 0
fi

if [ "$ACTION" = cancel ]; then
	[ -f "$BAK" ] || die "no $BAK: nothing to restore" 2
	cp -f "$BAK" "$EXTLINUX" || die "cannot restore $EXTLINUX" 6
	sync
	echo "[done] restored $EXTLINUX (boot default is now $(boot_default))"
	echo "[done] the next boot runs the installed system as before"
	exit 0
fi

[ -n "$URL" ] || usage
case "$URL" in
http://*|https://*) ;;
*) die "only http:// and https:// URLs are supported (got '$URL')" 1 ;;
esac

# Flash mode has to be present on the card: label, kernel, device tree, initramfs.
[ "$(label_field LINUX)" != "" ] || die "no LABEL $LABEL in $EXTLINUX" 2
[ "$(label_field INITRD)" != "" ] || die "LABEL $LABEL has no INITRD" 2
[ -f "$INITRAMFS" ] || die "$INITRAMFS is missing: rebuild the image with flash mode" 2
[ -f "$(label_field LINUX)" ] ||
	die "$(label_field LINUX) (from LABEL $LABEL) does not exist" 2
[ -f "$(label_field INITRD)" ] ||
	die "$(label_field INITRD) (from LABEL $LABEL) does not exist" 2

# ---------------------------------------------------------------- target disk
ROOT_PART=""
ROOT_WHOLE=""
majmin=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
if [ -n "$majmin" ]; then
	link=$(readlink -f "/sys/dev/block/$majmin") || link=""
	if [ -n "$link" ]; then
		ROOT_PART=$(basename "$link")
		ROOT_WHOLE=$(whole_disk_of "$ROOT_PART")
	fi
fi
[ -n "$ROOT_WHOLE" ] || die "cannot determine the disk holding /" 4
[ "$ROOT_PART" != "$ROOT_WHOLE" ] ||
	die "/ is mounted from /dev/$ROOT_WHOLE itself, not a partition: refusing" 4
TARGET=/dev/$ROOT_WHOLE
ROOTPART=/dev/$ROOT_PART
[ -b "$TARGET" ] || die "$TARGET is not a block device" 4
SECTORS=$(cat "/sys/class/block/$ROOT_WHOLE/size" 2>/dev/null) ||
	die "no sysfs entry for $ROOT_WHOLE" 4
TARGET_SIZE=$((SECTORS * 512))

# --------------------------------------------------------------- source check
BASE="${URL%.gz}"
SIDE_SHA="${BASE}.sha256"
SIDE_SIZE="${BASE}.size"
SIDE_BMAP="${BASE}.bmap"

echo "[source]"
echo "  url        : $URL"
echo "  sha256     : $SIDE_SHA"
echo "  size       : $SIDE_SIZE"
echo "  bmap       : $SIDE_BMAP"
echo "[target]"
echo "  device     : $TARGET"
echo "  size       : $TARGET_SIZE bytes ($((TARGET_SIZE / MB)) MiB)"
echo "  root       : $ROOTPART"

wget -q -T 15 --spider "$URL" || die "source not reachable: $URL" 3

fetch() { # $1 = url, $2 = output file; nonzero when unavailable or empty
	wget -q -T 15 -O "$2" "$1" 2>/dev/null && [ -s "$2" ]
}

TMP=$(mktemp -d) || die "cannot create a temporary directory" 6
trap 'rm -rf "$TMP"' EXIT INT TERM

EXPECT_SHA=""
EXPECT_SIZE=""
HAVE_BMAP=0
fetch "$SIDE_SHA" "$TMP/sha" && EXPECT_SHA=$(awk '{ print $1; exit }' "$TMP/sha")
fetch "$SIDE_SIZE" "$TMP/size" && EXPECT_SIZE=$(awk '{ print $1; exit }' "$TMP/size")
[ -n "$EXPECT_SHA" ] || die "cannot fetch $SIDE_SHA: refusing to arm unverified" 3
[ -n "$EXPECT_SIZE" ] || die "cannot fetch $SIDE_SIZE: refusing to arm" 3
case "$EXPECT_SHA" in *[!0-9a-fA-F]*|'') die "malformed sha256: $EXPECT_SHA" 3 ;; esac
[ "${#EXPECT_SHA}" = 64 ] || die "sha256 is ${#EXPECT_SHA} characters, not 64" 3
case "$EXPECT_SIZE" in *[!0-9]*) die "malformed size: $EXPECT_SIZE" 3 ;; esac
if [ "$TARGET_SIZE" -lt "$EXPECT_SIZE" ]; then
	die "target is too small: image needs $EXPECT_SIZE bytes, $TARGET holds $TARGET_SIZE" 4
fi

if [ "$MODE" = bmap ]; then
	if fetch "$SIDE_BMAP" "$TMP/bmap"; then
		HAVE_BMAP=1
		BMAP_SIZE=$(awk '/<ImageSize>/ { gsub(/<[^>]*>/, " "); print $1; exit }' "$TMP/bmap")
		[ "$BMAP_SIZE" = "$EXPECT_SIZE" ] ||
			die "bmap describes $BMAP_SIZE bytes but the image is $EXPECT_SIZE" 3
		echo "  bmap ranges: $(grep -c '<Range' "$TMP/bmap")"
	else
		echo "[warn] no $SIDE_BMAP: falling back to a full write" >&2
		MODE=full
	fi
fi

PARAMS="rdinit=/init console=ttyS0,115200 console=tty0 net.ifnames=0 loglevel=7"
PARAMS="$PARAMS video=HDMI-A-1:1920x1080@60e panic=30"
PARAMS="$PARAMS ota_url=$URL ota_sha256=$EXPECT_SHA ota_size=$EXPECT_SIZE"
PARAMS="$PARAMS ota_target=$TARGET ota_rootpart=$ROOTPART ota_mode=$MODE"
PARAMS="$PARAMS ota_hostname=$(hostname)"
[ "$HAVE_BMAP" = 1 ] && PARAMS="$PARAMS ota_bmap=$SIDE_BMAP"

echo
echo "Next boot runs flash mode instead of this system:"
echo "  $PARAMS"
echo

if [ "$TEST" = 1 ]; then
	echo "[test] source, metadata and target check out; nothing armed"
	echo "[test] a real run would back up $EXTLINUX, set DEFAULT $LABEL and reboot"
	exit 0
fi

if [ "$ASSUME_YES" = 0 ]; then
	printf 'Arm flash mode and reboot into it? (yes/no) '
	read -r answer
	[ "$answer" = "yes" ] || die "aborted by user" 4
fi

# ------------------------------------------------------------------- arming
if [ "$(boot_default)" = "$LABEL" ]; then
	echo "[warn] DEFAULT is already $LABEL: keeping the existing $BAK" >&2
else
	cp -f "$EXTLINUX" "$BAK" || die "cannot write $BAK" 6
	echo "[prep] saved the current boot configuration to $BAK"
fi

awk -v want="$LABEL" -v params="$PARAMS" '
	$1 == "LABEL" { inlabel = ($2 == want); print; next }
	inlabel && $1 == "APPEND" { print "  APPEND " params; next }
	{ print }
' "$EXTLINUX" > "$TMP/conf" || die "cannot edit $EXTLINUX" 6

awk -v want="$LABEL" '
	$1 == "DEFAULT" && !done { print "DEFAULT " want; done = 1; next }
	{ print }
' "$TMP/conf" > "$TMP/conf2" || die "cannot set the boot default" 6

[ "$(awk '$1 == "DEFAULT" { print $2 }' "$TMP/conf2")" = "$LABEL" ] ||
	die "the edited configuration has no DEFAULT $LABEL" 6
grep -q "APPEND .*ota_url=$URL" "$TMP/conf2" ||
	die "the edited configuration does not carry ota_url" 6

cat "$TMP/conf2" > "$EXTLINUX" || die "cannot write $EXTLINUX" 6
sync

echo "[done] armed: DEFAULT is $(boot_default), LABEL $LABEL carries the image URL"
echo "[note] the next boot downloads and writes $TARGET from RAM, with this OS not running"
echo "[note] a failure before the first byte restores $BAK and boots this system again"
echo "[note] 'ota-flash --cancel' before rebooting undoes the arming"

if [ "$NO_REBOOT" = 1 ]; then
	echo "[done] not rebooting (--no-reboot)"
	exit 0
fi
echo "[done] rebooting into flash mode"
reboot
