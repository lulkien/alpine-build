#!/sbin/openrc-run
# Arm one grow boot when the root filesystem is smaller than its partition, or when
# the partition is smaller than the disk (a medium installed as a plain image copy).
#
# This service used to grow the filesystem itself, with resize2fs on the mounted
# root. That wedges this board: the online path commits through the kernel's
# EXT4_IOC_RESIZE_FS, and the box stopped answering within ~15 s of starting it,
# came back in a watchdog reset loop, and left the filesystem unchanged and
# needing journal replay. The resize now happens in the RAM-only initramfs (the
# `grow` label), where nothing is mounted from the card and the work never enters
# that path: seconds, on the same card, for the same job.
#
# All that is left here is the decision and the arming — compare the filesystem
# with its partition, and when there is room, save the boot configuration, point
# DEFAULT at `grow`, count the attempt and reboot. That boot clears the counter on
# success and restores the boot configuration either way, so this stays a
# one-boot detour, and the counter keeps a resize that cannot finish from looping.
#
# Idempotent by comparison rather than by a marker file: when the filesystem
# already fills its partition this reports so and touches nothing.
#
# It runs in the default runlevel on purpose. Arming is a reboot, and a reboot is
# better taken with the system up (logs flushed, /var written) than from midway
# through the boot runlevel.

description="Grow the root filesystem into its partition on the next boot"

CONF=/boot/extlinux/extlinux.conf
BAK=$CONF.bak
INITRD=/boot/ram-initramfs.gz
ATTEMPTS=/var/lib/growfs/attempts
MAX_ATTEMPTS=2

# Partition-table reads, shared with the RAM modes that do the writing (grow mode
# extends the partition, this script only ever decides): one source, so the two
# cannot drift on what "there is room" means.
# shellcheck source=/dev/null
. /usr/lib/solovox/mbr.sh

depend() {
	after root localmount
}

root_device() {
	# mountinfo: field 3 is major:minor, field 5 is the mount point
	majmin=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
	[ -n "$majmin" ] || return 1
	for d in /sys/class/block/*; do
		[ "$(cat "$d/dev" 2>/dev/null)" = "$majmin" ] || continue
		echo "/dev/$(basename "$d")"
		return 0
	done
	return 1
}

start() {
	dev=$(root_device) || {
		eend 0 "cannot identify the root device, leaving the filesystem alone"
		return 0
	}
	sectors=$(cat "/sys/class/block/$(basename "$dev")/size" 2>/dev/null)
	[ -n "$sectors" ] || {
		eend 0 "no size known for $dev, leaving the filesystem alone"
		return 0
	}
	part_bytes=$((sectors * 512))

	fs_blocks=$(tune2fs -l "$dev" 2>/dev/null | awk '/^Block count:/ { print $3; exit }')
	fs_bsize=$(tune2fs -l "$dev" 2>/dev/null | awk '/^Block size:/ { print $3; exit }')
	[ -n "$fs_blocks" ] && [ -n "$fs_bsize" ] || {
		eend 0 "cannot read the filesystem size on $dev, leaving it alone"
		return 0
	}
	fs_bytes=$((fs_blocks * fs_bsize))

	# Two different kinds of room can be the reason to arm a grow boot, and saying
	# which one it is is the difference between a five-minute fix and an evening:
	# the filesystem can be smaller than its partition (what the online resize used
	# to handle right here), or the partition can be smaller than the disk - what a
	# medium installed as a plain image copy looks like, where the filesystem
	# already fills its partition and nothing running from it can see the rest. The
	# partition's usable end stops at the next partition's start, so a partition
	# after the root one is never grown over.
	disk=$(mbr_whole_disk_of "$(basename "$dev")")
	disk_sectors=$(cat "/sys/class/block/$disk/size" 2>/dev/null)
	start_sector=$(cat "/sys/class/block/$(basename "$dev")/start" 2>/dev/null)
	next_start=$(mbr_next_start "/dev/$disk" "${start_sector:-0}")
	if [ -n "$next_start" ]; then
		usable_end=$next_start
	else
		usable_end=${disk_sectors:-$sectors}
	fi
	room_bytes=$(( (usable_end - ${start_sector:-0}) * 512 ))

	if [ "$fs_bytes" -ge "$part_bytes" ] && [ "$part_bytes" -ge "$room_bytes" ]; then
		eend 0 "nothing to grow: the filesystem fills its partition and the partition fills the disk ($((part_bytes / 1048576)) MiB of $((disk_sectors / 2048)) MiB)"
		return 0
	fi

	if [ "$fs_bytes" -lt "$part_bytes" ]; then
		einfo "the filesystem ($((fs_bytes / 1048576)) MiB) is smaller than its partition ($((part_bytes / 1048576)) MiB)"
	else
		einfo "the partition ($((part_bytes / 1048576)) MiB) is smaller than the disk ($((disk_sectors / 2048)) MiB)"
	fi

	# There is room. Everything the grow boot needs has to be in this image.
	[ -f "$CONF" ] || {
		eend 1 "no $CONF: this image has no boot menu to arm"
		return 1
	}
	grep -q '^LABEL grow$' "$CONF" || {
		eend 1 "no grow label in $CONF: this image cannot grow the filesystem"
		return 1
	}
	[ -f "$INITRD" ] || {
		eend 1 "$INITRD is missing: this image cannot grow the filesystem"
		return 1
	}
	# Never step on a mode that is already armed: a `flash` default waiting for the
	# next boot belongs to ota-flash, and its backup is what restores it.
	current=$(awk '$1 == "DEFAULT" { print $2; exit }' "$CONF")
	case "$current" in
	grow | flash)
		eend 1 "DEFAULT is '$current': another boot mode is armed, leaving it alone"
		return 1
		;;
	esac

	attempts=$(cat "$ATTEMPTS" 2>/dev/null)
	case "$attempts" in
	'' | *[!0-9]*) attempts=0 ;;
	esac
	if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
		eend 1 "gave up after $attempts attempts: /var/log/grow.log has the last one; remove $ATTEMPTS to try again"
		return 1
	fi

	ebegin "arming one grow boot: $((fs_bytes / 1048576)) MiB filesystem, $((part_bytes / 1048576)) MiB partition, disk usable to $((usable_end / 2048)) MiB (attempt $((attempts + 1)) of $MAX_ATTEMPTS)"
	cp -f "$CONF" "$BAK" || {
		eend 1 "cannot write $BAK"
		return 1
	}
	awk '$1 == "DEFAULT" && !done { print "DEFAULT grow"; done = 1; next } { print }' \
		"$CONF" > "$CONF.new" || {
		eend 1 "cannot edit $CONF"
		return 1
	}
	[ "$(awk '$1 == "DEFAULT" { print $2; exit }' "$CONF.new")" = grow ] || {
		eend 1 "the edited $CONF does not default to grow"
		rm -f "$CONF.new"
		return 1
	}
	cat "$CONF.new" > "$CONF" || {
		eend 1 "cannot write $CONF"
		rm -f "$CONF.new"
		return 1
	}
	rm -f "$CONF.new"
	mkdir -p "$(dirname "$ATTEMPTS")"
	echo "$((attempts + 1))" > "$ATTEMPTS"
	sync
	eend 0
	einfo "rebooting into grow mode; that boot resizes with nothing mounted and restores $BAK itself"
	reboot
}
